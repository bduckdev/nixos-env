#!/usr/bin/env bash
set -euo pipefail

is_git_url() {
   local value="$1"

   [[ "$value" == https://* ||
      "$value" == http://* ||
      "$value" == ssh://* ||
      "$value" == git://* ||
      "$value" == *@*:* ]]
}

project_dir="${1:?Usage: create-project <parent-directory>}"

read -r -p "Project name or Git URL: " input
[[ -n "$input" ]] || exit 0

if is_git_url "$input"; then
   project_name="$(basename -- "${input%/}" .git)"
   project_name="${project_name##*:}"
   [[ -n "$project_name" ]] || exit 1

   new_project="$project_dir/$project_name"
   git clone -- "$input" "$new_project"
else
   new_project="$project_dir/$input"
   mkdir -- "$new_project"
fi

BDUCK_TMUX_LAYOUT_SESSION_DIR="$new_project" tmuxifier load-session dev
